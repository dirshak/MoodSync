# Primary LLM provider for emotion extraction + reply generation.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Fallback used automatically if GROQ_API_KEY is unset or a Groq call fails.
# Requires a local Ollama install (https://ollama.com) with a model pulled, e.g.:
#   ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional: override where Hugging Face model weights are cached (defaults to
# ~/.cache/huggingface). Useful if you want the ~1.5GB musicgen-small download
# to land on a different drive.
# HF_HOME=
